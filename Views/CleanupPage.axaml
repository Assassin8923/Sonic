<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sonic.Views.CleanupPage">

    <Grid x:Name="background" Background="Transparent" HorizontalAlignment="Center" Width="456" VerticalAlignment="Center" Height="450">

        <ListBox ItemsSource="{Binding Options}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Width="368" Height="180">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" FontSize="22" Height="48" Width="327" FontWeight="Bold" FontStyle="Italic" Cursor="Hand" Foreground="{DynamicResource ThemeButtonBrush}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="CButton" Content="Очистити" Background="{DynamicResource ThemeButtonBrush}" Foreground="{DynamicResource ThemeButtonTextBrush}" Margin="86,356,0,0" FontSize="36" Height="52" VerticalAlignment="Top" Cursor="Hand" FontFamily="Comic Sans MS" HorizontalAlignment="Left" Width="260" BorderThickness="0" Click="CButton_Click" IsEnabled="{Binding CanClean}"/>

        <Label x:Name="Choose" Content="Очищення системи, оберіть&#x0a;варіант очищення:" Foreground="{DynamicResource ThemeButtonBrush}" FontSize="28" Margin="32,10,0,0" VerticalAlignment="Top" FontStyle="Italic" FontFamily="Comic Sans MS" HorizontalAlignment="Left" Width="383" Background="Transparent"/>
        <Border BorderBrush="{DynamicResource ThemeButtonBrush}" BorderThickness="1" Height="174" VerticalAlignment="Center" HorizontalAlignment="Center" Width="368"/>
        <TextBlock Text="{Binding SelectedItemsText}" Margin="20,320,20,0" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource ThemeButtonBrush}" FontSize="16"/>
        <TextBlock Text="{Binding StatusText}" Margin="20,415,20,0" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource ThemeButtonBrush}" FontSize="16"/>
    </Grid>
</UserControl>
